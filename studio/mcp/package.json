{
  "name": "zonos-studio-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Zonos Voice Studio: design voices, speak and edit speech into Studio projects, with a player widget (MCP Apps).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "scripts": {
    "typecheck": "pnpm --dir .. run gen:api && tsc --noEmit -p .",
    "test": "pnpm --dir .. run gen:api && vitest run",
    "build": "pnpm --dir .. run gen:api && tsc --noEmit -p . && vite build && esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:@modelcontextprotocol/* --external:express --external:cors --external:zod --external:openapi-fetch --banner:js='#!/usr/bin/env node'",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "zod": "^4.2.0",
    "openapi-fetch": "^0.17.0",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@preact/preset-vite": "^2.10.6",
    "vite-plugin-singlefile": "^2.3.4",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0",
    "@types/node": "^26.6.6",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.19"
  }
}
