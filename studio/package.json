{
  "name": "zonos-voice-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.ts --default-non-nullable false --empty-objects-unknown --array-length",
    "build": "pnpm gen:api && tsc --noEmit -p . && vite build",
    "typecheck": "pnpm gen:api && tsc --noEmit -p .",
    "preview": "vite preview",
    "build:web": "pnpm --dir ../servers/web build && rm -rf dist/web-engine && cp -r ../servers/web/dist dist/web-engine"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "openapi-fetch": "^0.17.0",
    "preact": "^11.0.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "0.1.0",
    "sirv": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
