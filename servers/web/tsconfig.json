{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2024",
      "DOM",
      "WebWorker"
    ],
    "types": [
      "@webgpu/types",
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src",
    "harness",
    "vite.config.ts"
  ],
  "exclude": [
    "harness/*.mjs"
  ]
}
