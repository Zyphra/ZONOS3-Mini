{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zonos3-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The deployed site is the studio build with the engine in web-engine/ (pnpm --dir ../../studio build:web); the
  // models come from the Hugging Face Hub (worker/index.ts redirects /models/*).
  "assets": {
    "directory": "../../studio/dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/models/*", "/v1/*", "/v2/*"]
  }
}
