+// Contiguous element-wise conversion. One thread converts four consecutive elements;
+// the row-wise kernel above launches one threadgroup per row, which is slow for the
+// narrow [C, T] activations (C = 64..128, T ~ 1e6) the codec encoder produces.
+template<typename T0, typename T1>
+kernel void kernel_cpy_cont_t_t(
+        constant int64_t & n,
+        device const char * src0,
+        device       char * dst,
+        uint tpig[[thread_position_in_grid]]) {
+    const int64_t i = (int64_t) tpig * 4;
+    device const T0 * src = (device const T0 *) src0;
+    device       T1 * out = (device       T1 *) dst;
+    if (i + 4 <= n) {
+        out[i + 0] = (T1) src[i + 0];
+        out[i + 1] = (T1) src[i + 1];
+        out[i + 2] = (T1) src[i + 2];
+        out[i + 3] = (T1) src[i + 3];
+    } else {
+        for (int64_t j = i; j < n; ++j) out[j] = (T1) src[j];
+    }
+}
