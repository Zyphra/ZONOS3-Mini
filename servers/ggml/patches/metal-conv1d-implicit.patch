+// ggml_compute_forward_conv_1d_implicit
+// src0: w   BF16 [K*IC, OC], r = ic*K + k
+// src1: x   F32  [IC, T]
+// dst:  y   F32  [OC, T_out]
+void ggml_compute_forward_conv_1d_implicit(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_BF16);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+
+    const int32_t K        = ggml_get_op_params_i32(dst, 0);
+    const int32_t stride   = ggml_get_op_params_i32(dst, 1);
+    const int32_t dilation = ggml_get_op_params_i32(dst, 2);
+    const int32_t pad_left = ggml_get_op_params_i32(dst, 3);
+
+    const int64_t IC    = src1->ne[0];
+    const int64_t T     = src1->ne[1];
+    const int64_t KIC   = src0->ne[0];
+    const int64_t OC    = src0->ne[1];
+    const int64_t T_out = dst->ne[1];
+
+    GGML_ASSERT(KIC == IC*K);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t dr  = (OC + nth - 1)/nth;
+    const int64_t ir0 = dr*ith;
+    const int64_t ir1 = MIN(ir0 + dr, OC);
+
+    const float * x = (const float *) src1->data;
+
+    std::vector<float> wf(KIC);
+
+    for (int64_t oc = ir0; oc < ir1; oc++) {
+        const ggml_bf16_t * w = (const ggml_bf16_t *) ((const char *) src0->data + oc*src0->nb[1]);
+        for (int64_t r = 0; r < KIC; r++) {
+            wf[r] = GGML_BF16_TO_FP32(w[r]);
+        }
+
+        for (int64_t t = 0; t < T_out; t++) {
+            float sum = 0.0f;
+            for (int64_t ic = 0; ic < IC; ic++) {
+                const float * wk = wf.data() + ic*K;
+                for (int32_t k = 0; k < K; k++) {
+                    const int64_t ti = t*stride + (int64_t) k*dilation - pad_left;
+                    if (ti < 0 || ti >= T) {
+                        continue;
+                    }
+                    // round to bf16 like the BF16 x F32 matmul path does for src1
+                    const float xv = GGML_BF16_TO_FP32(GGML_FP32_TO_BF16(x[ic + IC*ti]));
+                    sum += wk[k]*xv;
+                }
+            }
+            *(float *) ((char *) dst->data + t*dst->nb[1] + oc*dst->nb[0]) = sum;
+        }
+    }
+}
