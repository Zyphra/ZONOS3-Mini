+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_conv_1d_implicit(ggml_metal_library_t lib, const ggml_tensor * op) {
+    assert(op->op == GGML_OP_CONV_1D_IMPLICIT);
+
+    GGML_ASSERT(ggml_is_contiguous(op->src[0]));
+    GGML_ASSERT(ggml_is_contiguous(op->src[1]));
+    GGML_ASSERT(op->src[0]->type == GGML_TYPE_BF16);
+    GGML_ASSERT(op->src[1]->type == GGML_TYPE_F32);
+    GGML_ASSERT(op->type         == GGML_TYPE_F32);
+
+    const int32_t K        = ggml_get_op_params_i32(op, 0);
+    const int32_t stride   = ggml_get_op_params_i32(op, 1);
+    const int32_t dilation = ggml_get_op_params_i32(op, 2);
+
+    GGML_ASSERT(K <= INT16_MAX && stride <= INT16_MAX && dilation <= INT16_MAX);
+
+    const bool bc_inp = op->src[0]->ne[0] % 32 != 0;
+    const bool bc_out = op->ne[0] % 64 != 0 || op->ne[1] % 32 != 0;
+
+    char base[256];
+    char name[256];
+
+    snprintf(base, 256, "kernel_conv1d_implicit_bf16");
+    snprintf(name, 256, "%s_bci=%d_bco=%d_k=%d_s=%d_d=%d", base, bc_inp, bc_out, K, stride, dilation);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        ggml_metal_cv_t cv = ggml_metal_cv_init();
+
+        ggml_metal_cv_set_bool (cv, bc_inp,             FC_CONV_1D_IMPLICIT + 0);
+        ggml_metal_cv_set_bool (cv, bc_out,             FC_CONV_1D_IMPLICIT + 1);
+        ggml_metal_cv_set_int16(cv, (int16_t) K,        FC_CONV_1D_IMPLICIT + 2);
+        ggml_metal_cv_set_int16(cv, (int16_t) stride,   FC_CONV_1D_IMPLICIT + 3);
+        ggml_metal_cv_set_int16(cv, (int16_t) dilation, FC_CONV_1D_IMPLICIT + 4);
+
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+
+        ggml_metal_cv_free(cv);
+    }
+
+    res.nr0  = 64;
+    res.nr1  = 32;
+    res.nsg  = 4;
+    res.smem = 8192;
+
+    return res;
+}
