+// ggml_conv_1d_implicit
+
+struct ggml_tensor * ggml_conv_1d_implicit(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * x,
+        int                   K,
+        int                   stride,
+        int                   dilation,
+        int                   pad_left) {
+    GGML_ASSERT(w->type == GGML_TYPE_BF16);
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(w) && ggml_is_matrix(w));
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_matrix(x));
+    GGML_ASSERT(K > 0 && stride > 0 && dilation > 0 && pad_left >= 0);
+    GGML_ASSERT(x->ne[0] * K == w->ne[0]);
+
+    const int64_t T     = x->ne[1];
+    const int64_t T_out = (T + pad_left - (int64_t) dilation*(K - 1) - 1)/stride + 1;
+    GGML_ASSERT(T_out > 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, w->ne[1], T_out);
+
+    int32_t params[] = { K, stride, dilation, pad_left };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_CONV_1D_IMPLICIT;
+    result->src[0] = w;
+    result->src[1] = x;
+
+    return result;
+}
