+    // keep in sync with the F32-precision routing in ggml_cuda_mul_mat_id
+    if (ggml_get_op_params_i32(dst, 0) == GGML_PREC_F32 && !ggml_is_quantized(src0->type) &&
+        ggml_cuda_should_use_mmvf(src0->type, cc, WARP_SIZE, src0->ne, src0->nb, src1->ne[2])) {
+        return false;
