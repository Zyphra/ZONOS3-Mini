         ggml_cuda_mul_mat_vec_f(ctx, src1, src0, nullptr, &dst_vec);
         return;
     }
-    if (ggml_cuda_should_use_mmf(src0->type, cc, warp_size, src0->ne, src0->nb, ne11, /*mul_mat_id =*/ false)) {
+    // GGML_PREC_F32 requests F32 arithmetic; MMF would run F32 operands through TF32 tensor cores.
+    if (ggml_get_op_params_i32(dst, 0) != GGML_PREC_F32 &&
+        ggml_cuda_should_use_mmf(src0->type, cc, warp_size, src0->ne, src0->nb, ne11, /*mul_mat_id =*/ false)) {
