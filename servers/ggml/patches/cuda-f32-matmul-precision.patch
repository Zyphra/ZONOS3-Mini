+        // GGML_PREC_F32: prefer the F32-accumulating vector kernel and never enter MMF's TF32 arithmetic
+        if (ggml_get_op_params_i32(dst, 0) == GGML_PREC_F32 && !ggml_is_quantized(src0->type) &&
