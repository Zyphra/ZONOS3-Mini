+
+    if (ggml_get_op_params_i32(dst, 0) != GGML_PREC_F32 &&
+        ggml_cuda_should_use_mmf(src0->type, cc, WARP_SIZE, src0->ne, src0->nb, src1->ne[2], /*mul_mat_id=*/true)) {
         return false;
     }
 
