+// Plain F32 softmax follows PyTorch CUDA's persistent/register reduction
+// ordering. Small F32 differences can cross a following BF16 rounding midpoint;
+// an inter-warp block tree or reciprocal multiplication is not interchangeable.
+template <int log2_columns>
+static __global__ void soft_max_plain_warp_f32(const float * x, float * dst, int columns, int64_t rows) {
+    constexpr int padded = 1 << log2_columns;
+    constexpr int width = padded < WARP_SIZE ? padded : WARP_SIZE;
+    constexpr int iterations = padded/width;
+    constexpr int batches = padded <= 128 ? 2 : 1;
+    const int64_t first = ((int64_t) blockDim.y*blockIdx.x + threadIdx.y)*batches;
+    float values[batches][iterations];
+    float maximum[batches], sum[batches] = {};
+    for (int b = 0; b < batches; ++b) {
+        #pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            const int col = threadIdx.x + i*width;
+            values[b][i] = first+b < rows && col < columns ? x[(first+b)*columns+col] : -INFINITY;
+        }
+        maximum[b] = values[b][0];
+        #pragma unroll
+        for (int i = 0; i < iterations; ++i)
+            maximum[b] = maximum[b] > values[b][i] ? maximum[b] : values[b][i];
+    }
+    #pragma unroll
+    for (int offset = width/2; offset > 0; offset /= 2) {
+        #pragma unroll
+        for (int b = 0; b < batches; ++b) {
+            const float other = __shfl_xor_sync(0xffffffff,maximum[b],offset,width);
+            maximum[b] = maximum[b] < other ? other : maximum[b];
+        }
+    }
+    #pragma unroll
+    for (int b = 0; b < batches; ++b) {
+        #pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            values[b][i] = expf(values[b][i]-maximum[b]);
+            sum[b] += values[b][i];
+        }
+    }
+    #pragma unroll
+    for (int offset = width/2; offset > 0; offset /= 2) {
+        #pragma unroll
+        for (int b = 0; b < batches; ++b)
+            sum[b] += __shfl_xor_sync(0xffffffff,sum[b],offset,width);
+    }
+    #pragma unroll
+    for (int b = 0; b < batches; ++b) {
+        if (first+b < rows) {
+            #pragma unroll
+            for (int i = 0; i < iterations; ++i) {
+                const int col = threadIdx.x + i*width;
+                if (col < columns) dst[(first+b)*columns+col] = values[b][i]/sum[b];
+            }
+        }
+    }
+}
+
+template <bool maximum>
+static __device__ __forceinline__ float soft_max_plain_block_reduce(float value, float * shared) {
+    const int lane = threadIdx.x%WARP_SIZE, warp = threadIdx.x/WARP_SIZE;
+    const float identity = maximum ? -FLT_MAX : 0.0f;
+    #pragma unroll
+    for (int offset = WARP_SIZE/2; offset > 0; offset /= 2) {
+        const int source = lane+offset < WARP_SIZE ? lane+offset : lane;
+        const float other = __shfl_sync(0xffffffff,value,source,WARP_SIZE);
+        if constexpr (maximum) value = value < other ? other : value;
+        else value += other;
+    }
+    __syncthreads();
+    if (lane == 0) shared[warp] = value;
+    __syncthreads();
+    value = threadIdx.x < blockDim.x/WARP_SIZE ? shared[lane] : identity;
+    if (warp == 0) {
+        #pragma unroll
+        for (int offset = WARP_SIZE/2; offset > 0; offset /= 2) {
+            const int source = lane+offset < WARP_SIZE ? lane+offset : lane;
+            const float other = __shfl_sync(0xffffffff,value,source,WARP_SIZE);
+            if constexpr (maximum) value = value < other ? other : value;
+            else value += other;
+        }
+    }
+    if (threadIdx.x == 0) shared[0] = value;
+    __syncthreads();
+    return shared[0];
+}
+
+template <int registers>
+static __global__ void soft_max_plain_reg_f32(const float * x, float * dst, int columns) {
+    x += (int64_t) blockIdx.x*columns;
+    dst += (int64_t) blockIdx.x*columns;
+    float values[registers], maximum = -FLT_MAX, sum = 0.0f;
+    extern __shared__ float shared[];
+    #pragma unroll
+    for (int i = 0; i < registers; ++i) {
+        const int col = threadIdx.x + i*blockDim.x;
+        if (col < columns) {
+            values[i] = x[col];
+            maximum = fmaxf(maximum,values[i]);
+        }
+    }
+    maximum = soft_max_plain_block_reduce<true>(maximum,shared);
+    #pragma unroll
+    for (int i = 0; i < registers; ++i) {
+        if (threadIdx.x + i*blockDim.x < columns) {
+            values[i] = expf(values[i]-maximum);
+            sum += values[i];
+        }
+    }
+    sum = soft_max_plain_block_reduce<false>(sum,shared);
+    #pragma unroll
+    for (int i = 0; i < registers; ++i) {
+        const int col = threadIdx.x + i*blockDim.x;
+        if (col < columns) dst[col] = values[i]/sum;
+    }
+}
+
+static void soft_max_plain_f32_cuda(const float * x, float * dst, int columns, int64_t rows, cudaStream_t stream) {
+    if (columns <= 2048) {
+        int power = 0;
+        while ((1 << power) < columns) ++power;
+        const int width = std::min(1 << power,WARP_SIZE);
+        const int batches = (1 << power) <= 128 ? 2 : 1;
+        const dim3 threads(width,128/width,1);
+        const int64_t per_block = threads.y*batches;
+        const dim3 blocks((rows+per_block-1)/per_block);
+        #define GGML_SOFT_MAX_PLAIN_WARP(N) case N: \
+            soft_max_plain_warp_f32<N><<<blocks,threads,0,stream>>>(x,dst,columns,rows); break
+        switch (power) {
+            GGML_SOFT_MAX_PLAIN_WARP(0); GGML_SOFT_MAX_PLAIN_WARP(1);
+            GGML_SOFT_MAX_PLAIN_WARP(2); GGML_SOFT_MAX_PLAIN_WARP(3);
+            GGML_SOFT_MAX_PLAIN_WARP(4); GGML_SOFT_MAX_PLAIN_WARP(5);
+            GGML_SOFT_MAX_PLAIN_WARP(6); GGML_SOFT_MAX_PLAIN_WARP(7);
+            GGML_SOFT_MAX_PLAIN_WARP(8); GGML_SOFT_MAX_PLAIN_WARP(9);
+            GGML_SOFT_MAX_PLAIN_WARP(10); GGML_SOFT_MAX_PLAIN_WARP(11);
+        }
+        #undef GGML_SOFT_MAX_PLAIN_WARP
+    } else {
+        const dim3 threads(1024,1,1), blocks(rows);
+        const size_t shared_bytes = (1024/WARP_SIZE)*sizeof(float);
+        #define GGML_SOFT_MAX_PLAIN_REG(N) case N: \
+            soft_max_plain_reg_f32<N><<<blocks,threads,shared_bytes,stream>>>(x,dst,columns); break
+        switch ((columns+1023)/1024) {
+            GGML_SOFT_MAX_PLAIN_REG(3); GGML_SOFT_MAX_PLAIN_REG(4);
+            GGML_SOFT_MAX_PLAIN_REG(5); GGML_SOFT_MAX_PLAIN_REG(6);
+            GGML_SOFT_MAX_PLAIN_REG(7); GGML_SOFT_MAX_PLAIN_REG(8);
+            GGML_SOFT_MAX_PLAIN_REG(9);
+        }
+        #undef GGML_SOFT_MAX_PLAIN_REG
+    }
+}
